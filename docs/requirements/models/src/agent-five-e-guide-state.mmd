%% 图题：五步引导状态
%% 问题：五步引导如何进入、每一步做什么、何时结束？
%% 来源：REQ-AGENT-001、REQ-AGENT-003、Q-135
%% 待定：Q-134 未回答（如何判断系统学习意图、退出后的具体表现未写明）；本图按需求中已写的触发条件画。
%%{init: {'theme':'neutral','themeVariables':{'fontFamily':'Microsoft YaHei, Segoe UI, sans-serif','fontSize':'16px'},'themeCSS':'.statediagram-note .outer-path path[fill=\"#666\"]{fill:#FFF8E1 !important;} .statediagram-note .outer-path path[stroke=\"#999\"]{stroke:#C9A227 !important;} .statediagram-note text,.statediagram-note tspan,.statediagram-note .nodeLabel{fill:#1A202C !important;color:#1A202C !important;}'}}%%
stateDiagram-v2
  direction LR
  state "参与<br/>问已知与目标、说明主题" as 参与
  state "探究<br/>给例子或小任务尝试" as 探究
  state "解释<br/>讲解并检查理解" as 解释
  state "迁移<br/>给新情境或变式题" as 迁移
  state "评价<br/>检验、反馈、总结与建议" as 评价
  [*] --> 普通对话
  普通对话 --> 参与: 表达意图或点击入口，提议引导
  参与 --> 探究: 学生回答后
  探究 --> 解释: 学生尝试后
  解释 --> 迁移: 学生回答后
  迁移 --> 评价: 学生尝试后
  评价 --> 普通对话: 总结后完成
  note right of 评价
    任意一步说“直接告诉我”
    或“退出引导”即结束引导
  end note
